    m_Localized: "Mk14 Mod0\u589E\u5F3A\u4F5C\u6218\u6B65\u67AA\u662F\u7F8E\u56FD\u57FA\u4E8EM14\u6B65\u67AA\u6539\u8FDB\u76847.62\xD751\u6BEB\u7C73\u5317\u7EA6\u53E3\u5F84\u519B\u7528\u6B65\u67AA\uFF0C\u7531\u53F2\u5BC6\u65AF\u4F01\u4E1A\u516C\u53F8\u548C\u6625\u7530\u516C\u53F8\u7814\u5236\uFF0C2004\u5E74\u6B63\u5F0F\u670D\u5F79\u3002\u8BE5\u67AA\u91C7\u7528\u53EF\u62C6\u5378\u5F39\u5323\u4F9B\u5F39\uFF0C\u517C\u5177\u7279\u7B49\u5C04\u624B\u6B65\u67AA\u4E0E\u8FD1\u6218\u529F\u80FD\uFF0C\u4E3B\u8981\u88C5\u5907\u7F8E\u56FD\u6D77\u519B\u6D77\u8C79\u90E8\u961F\u7B49\u7279\u79CD\u5355\u4F4D,\u53EF\u5FEB\u901F\u52A0\u88C5\u76AE\u5361\u6C40\u5C3C\u5BFC\u8F68\u914D\u4EF6\u3002"
